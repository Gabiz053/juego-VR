  m_Script: {fileID: 11500000, guid: c83f3f9bdf3342e6bd4c8796ece6293f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _wristMenuController: {fileID: 836865363}
  _orbitalPauseController: {fileID: 1829900471}
  _orbitVisibilityController: {fileID: 1829900472}
  _mainMenuSceneName: Main_VR
  _currentSceneIndex: 1
  _planetPrefab: {fileID: 8492967959566658416, guid: c0b975ee0db2e3d33958febbe16241d9, type: 3}
  _planetPrefabs: []
  _cameraTransform: {fileID: 47491072}
  _spawnDistance: 1.5
  _showIntroPanel: 0
  _useUnifiedPanelStyle: 1
  _introFadeInDuration: 1
  _introHoldDuration: 4
  _introFadeOutDuration: 1.5
  _introText: '<size=120%><b>KeplerLab 2</b></size>

    <size=80%>(Segunda Ley de
    Kepler)</size>


    1. Pulsa <b>Spawn Planet</b> para crear un planeta.

    2.
    Manten pulsado el grip de cualquier mano para iniciar la medicion.

    3. Suelta
    el grip para calcular el tiempo orbital segun el area barrida.

    4. Pausa
    para leer la explicacion de la ley.


    <size=80%>En tiempos iguales, el radio
    vector barre areas iguales.</size>'
  _showExplanationOnPause: 1
  _placeKepler2PausePanelAboveSun: 1
  _kepler2PausePanelSunOffset: {x: 0, y: 2.2, z: 0}
  _rightControllerAnchor: {fileID: 0}
  _panelLocalOffset: {x: 0, y: 0.18, z: 0.05}
  _panelLocalEuler: {x: 45, y: 0, z: 0}
  _panelControllerScale: 0.08
  _messageDistance: 4
  _messageHeightOffset: 0.3
  _messagePanelSize: {x: 3, y: 1.6}
  _messageFontSize: 0.16
  _messageFont: {fileID: 0}
  _explanationText: "<size=120%><b>Segunda Ley de Kepler</b></size>\n<size=80%>(Ley
    de las areas)</size>\n\nEn tiempos iguales, el radio vector planeta-Sol barre
    <b>areas iguales</b>.\n\n\u25CF Cerca del Sol, el planeta se mueve mas rapido.\n\u25CF
    Lejos del Sol, se mueve mas lento.\n\u25CF La cantidad de area barrida depende
    del tiempo medido.\n\n<size=80%>Pulsa pausa de nuevo para reanudar.</size>"
  _unifiedPanelLocalOffset: {x: 0, y: 0.11, z: 0.05}
  _unifiedPanelLocalEuler: {x: 45, y: 0, z: 0}
  _unifiedPanelControllerScale: 0.08
  _unifiedPanelSize: {x: 3, y: 1.6}
  _unifiedPanelFontSize: 0.16
